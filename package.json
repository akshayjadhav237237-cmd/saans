{
  "name": "saans",
  "version": "0.1.0",
  "description": "GenAI urban air quality assistant for families and communities in severe winter smog",
  "license": "MIT",
  "author": "Akshay",
  "repository": {
    "type": "git",
    "url": "https://github.com/akshayjadhav237237-cmd/saans.git"
  },
  "keywords": [
    "air-quality",
    "aqi",
    "smog",
    "delhi",
    "exposure-budget",
    "genai"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "knip": "knip",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run knip && npm run test:cov && npm run build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.14.0",
    "@fontsource-variable/inter": "5.1.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/jsdom": "21.1.7",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "10.4.20",
    "eslint": "9.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "knip": "5.36.0",
    "postcss": "8.5.32",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
